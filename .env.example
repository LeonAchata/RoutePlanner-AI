# Required
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Language model used to read the trip description
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Geocoding: language of returned addresses and the country to bias results to
GEOCODING_LANGUAGE=es
DEFAULT_COUNTRY=PE

# Maximum number of stops per route, origin included (hard limit: 25)
MAX_STOPS=25

# Comma separated list of allowed origins, or * for any
CORS_ORIGINS=*
DEBUG=false
